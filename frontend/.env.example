# Ember Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# Required: Privy Authentication
# ===========================================
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# ===========================================
# Required: Ember Contract Address
# ===========================================
NEXT_PUBLIC_EMBER_ADDRESS=0x_your_deployed_contract_address

# ===========================================
# Shinami Gas Station (Gasless Transactions)
# ===========================================
# Get your API key at https://www.shinami.com/
# Key format: us1_movement_testnet_xxx or us1_movement_mainnet_xxx
# Server-side only - never exposed to client
SHINAMI_KEY=

# ===========================================
# Optional: Supabase
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===========================================
# Optional: IPFS/Pinata for file uploads
# ===========================================
PINATA_JWT=
NEXT_PUBLIC_GATEWAY_URL=
