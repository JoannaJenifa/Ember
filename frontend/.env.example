# Ember Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# Required: Privy Authentication
# ===========================================
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# ===========================================
# Required: Ember Contract Address
# ===========================================
NEXT_PUBLIC_EMBER_ADDRESS=0x_your_deployed_contract_address

# ===========================================
# Shinami Integration (Gasless Transactions)
# ===========================================
# Get your API keys at https://www.shinami.com/
# Gas Station key format: us1_movement_testnet_xxx or us1_movement_mainnet_xxx

# Gas Station API Key - enables gasless transactions for users
# SERVER-SIDE ONLY - do not prefix with NEXT_PUBLIC_
SHINAMI_GAS_KEY=

# Node Service API Key - provides reliable RPC endpoint (optional)
# This is safe to expose client-side as it's only for read operations
NEXT_PUBLIC_SHINAMI_NODE_KEY=

# ===========================================
# Optional: Supabase (if using for additional data)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===========================================
# Optional: IPFS/Pinata for file uploads
# ===========================================
PINATA_JWT=
NEXT_PUBLIC_GATEWAY_URL=
